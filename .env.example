# Neo4j
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-neo4j-password
NEO4J_URI=bolt://localhost:7687
NEO4J_HEAP=2G
NEO4J_PAGECACHE=2G
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# Yandex Cloud AI
YANDEX_CLOUD_FOLDER=
YANDEX_CLOUD_API_KEY=
YANDEX_CLOUD_MODEL=gpt://b1ghh2ufu3o0t33psog1/deepseek-v4.1-flash/latest
YANDEX_EMBEDDING_MODEL=emb://b1ggusvist6c2sia1dno/text-search-doc/latest
YANDEX_CLOUD_BASE_URL=https://ai.api.cloud.yandex.net/v1
YANDEX_VISION_MODEL=
LLM_PROVIDER=yandex
LLM_REQUEST_TIMEOUT_SECONDS=120

# Shared maximum LLM token budget per PDF ingestion job, including images,
# text inputs, and model responses. The value is snapshotted when a job starts.
TOKEN_LIMIT=1000000
EMBEDDING_DIMENSIONS=256
EMBEDDING_SIMILARITY_THRESHOLD=0.82
DICTIONARY_CONTEXT_TOP_K=15
ENTITY_MIN_OCCURRENCES=2

# PostgreSQL
POSTGRES_DB=nikelpower
POSTGRES_USER=nikelpower
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_PORT=5432

# Redis
REDIS_PASSWORD=change-me-redis-password
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Local paths
DOCUMENTS_DIR=./data/documents
INGESTION_STATE_DIR=./data/ingestion
CONVERTED_PDF_DIR=./data/ingestion/converted
PARSED_DOCUMENTS_DIR=./data/processed

# Ingestion tuning
CHUNK_TARGET_TOKENS=850
CHUNK_MAX_TOKENS=1000
CHUNK_OVERLAP_PARAGRAPHS=1
INGESTION_BATCH_SIZE=10
GRAPHITI_GROUP_ID=nikelpower
ANALYZE_DOCUMENT_IMAGES=true

# Optional format-conversion fallback
LIBREOFFICE_BINARY=libreoffice
LIBREOFFICE_TIMEOUT_SEC=180

# API and local development
BACKEND_PORT=8000
MAX_UPLOAD_SIZE_BYTES=52428800
CORS_ORIGINS=["http://localhost:5173"]

# Application logs (rotating JSON Lines files)
LOG_DIR=./logs
LOG_LEVEL=INFO
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
